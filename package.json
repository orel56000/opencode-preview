{
  "name": "@orel56000/opencode-preview",
  "version": "0.1.0",
  "description": "Native preview manager for OpenCode Desktop — start, stop, restart and open development servers directly from the app.",
  "type": "module",
  "license": "MIT",
  "author": "orel56000",
  "repository": {
    "type": "git",
    "url": "https://github.com/orel56000/opencode-preview.git"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "electron",
    "solidjs",
    "developer-tools",
    "preview",
    "dev-server",
    "typescript"
  ],
  "files": [
    "src",
    "dist",
    "desktop-patch",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.jsx",
      "default": "./dist/tui.jsx"
    },
    "./service": {
      "types": "./dist/service/service.d.ts",
      "import": "./dist/service/service.js",
      "default": "./dist/service/service.js"
    },
    "./preload": {
      "types": "./dist/service/preload.d.ts",
      "import": "./dist/service/preload.js",
      "default": "./dist/service/preload.js"
    },
    "./service-client": {
      "types": "./dist/service/client.d.ts",
      "import": "./dist/service/client.js",
      "default": "./dist/service/client.js"
    },
    "./ipc": {
      "types": "./dist/service/ipc.d.ts",
      "import": "./dist/service/ipc.js",
      "default": "./dist/service/ipc.js"
    },
    "./desktop": {
      "types": "./dist/desktop/index.d.ts",
      "import": "./dist/desktop/index.js",
      "default": "./dist/desktop/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && cd dist-test && node --test",
    "lint": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "open": "^10.1.0",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": ">=1.18.21",
    "@opentui/core": ">=0.5.8",
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opencode-ai/plugin": "1.18.29",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/node": "^22.0.0",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=20"
  }
}
