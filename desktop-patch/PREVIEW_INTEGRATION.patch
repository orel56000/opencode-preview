--- a/packages/app/src/components/previews/preview-host-init.tsx
+++ b/packages/app/src/components/previews/preview-host-init.tsx
@@
+import { PreviewHost } from "@orel56000/opencode-preview/desktop"
+import { PreviewClient } from "@orel56000/opencode-preview/service-client"
+import { registerChatToolbarAction } from "@/components/chat-toolbar-slot"
+
+/**
+ * Registers the Preview button right after the context indicator
+ * (order 10 keeps it adjacent; context usage is order 0).
+ */
+export function initPreviewToolbar(): () => void {
+  const client = new PreviewClient({ bridge: window.electronAPI.previews })
+  return registerChatToolbarAction({
+    id: "preview",
+    order: 10,
+    render: () => <PreviewHost client={client} />,
+  })
+}
