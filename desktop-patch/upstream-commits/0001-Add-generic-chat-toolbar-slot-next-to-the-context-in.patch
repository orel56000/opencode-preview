Subject: [PATCH 1/2] Add generic chat toolbar slot next to the context
 indicator

---
 .../app/src/components/chat-toolbar-slot.tsx  | 59 +++++++++++++++++++
 .../session/timeline/message-timeline.tsx     |  2 +
 2 files changed, 61 insertions(+)
 create mode 100644 packages/app/src/components/chat-toolbar-slot.tsx

diff --git a/packages/app/src/components/chat-toolbar-slot.tsx b/packages/app/src/components/chat-toolbar-slot.tsx
new file mode 100644
index 0000000..235ddb8
--- /dev/null
+++ b/packages/app/src/components/chat-toolbar-slot.tsx
@@ -0,0 +1,59 @@
+import { For, type JSX } from "solid-js"
+
+export interface ChatToolbarAction {
+  /** Unique action id, e.g. `"preview"`. */
+  id: string
+  /** Render order; lower renders first. The context usage indicator is `0`. */
+  order?: number
+  /** Rendered inline in the chat toolbar, beside the context indicator. */
+  render: () => JSX.Element
+}
+
+const actions = new Map<string, ChatToolbarAction>()
+const listeners = new Set<() => void>()
+
+function notify(): void {
+  for (const listener of listeners) listener()
+}
+
+/**
+ * Generic chat-toolbar extension primitive.
+ *
+ * Plugins and built-in features register toolbar actions here instead of
+ * patching toolbar files directly:
+ *
+ * ```tsx
+ * registerChatToolbarAction({
+ *   id: "preview",
+ *   order: 10,
+ *   render: () => <PreviewButton />,
+ * })
+ * ```
+ */
+export function registerChatToolbarAction(action: ChatToolbarAction): () => void {
+  actions.set(action.id, action)
+  notify()
+  return () => {
+    if (actions.delete(action.id)) notify()
+  }
+}
+
+export function getChatToolbarActions(): ChatToolbarAction[] {
+  return [...actions.values()].sort((a, b) => (a.order ?? 100) - (b.order ?? 100))
+}
+
+export function onChatToolbarActionsChange(listener: () => void): () => void {
+  listeners.add(listener)
+  return () => {
+    listeners.delete(listener)
+  }
+}
+
+/** Renders registered actions inline, directly after the context indicator. */
+export function ChatToolbarSlot(): JSX.Element {
+  return (
+    <For each={getChatToolbarActions()}>
+      {(action) => action.render()}
+    </For>
+  )
+}
