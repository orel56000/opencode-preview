+import { Show, createMemo, createSignal, type JSX } from "solid-js"
+import { usePlatform } from "@/context/platform"
+import { useSDK } from "@/context/sdk"
+import { createPreviewStore } from "./store"
+import { PreviewButton } from "./PreviewButton"
+import { PreviewPanel } from "./PreviewPanel"
+
+/**
+ * Preview toolbar entry: `[ Preview ]` beside the context indicator.
+ * Rendered through the generic `ChatToolbarSlot`; hidden when the platform
+ * provides no preview backend (e.g. the web build).
+ */
+export function PreviewHost(): JSX.Element {
+  const platform = usePlatform()
+  const sdk = useSDK()
+  const [open, setOpen] = createSignal(false)
+
+  const store = createMemo(() => {
+    const backend = platform.previews
+    if (!backend) return undefined
+    return createPreviewStore(backend, sdk().directory)
+  })
+
+  return (
+    <Show when={store()}>
+      {(preview) => (
+        <span class="relative inline-flex">
+          <PreviewButton
+            snapshots={preview().snapshots()}
+            open={open()}
+            onToggle={() => setOpen((v) => !v)}
+          />
+          <Show when={open()}>
+            <div class="absolute right-0 top-full z-50 mt-2">
+              <PreviewPanel
+                snapshots={preview().snapshots()}
+                logs={(id) => preview().logs(id)}
+                actions={{
+                  onStart: (id) => void preview().start(id),
+                  onStop: (id) => void preview().stop(id),
+                  onRestart: (id) => void preview().restart(id),
+                  onOpen: (id) => void preview().open(id),
+                  onSelect: () => {},
+                  onRefreshLogs: (id) => void preview().refreshLogs(id),
+                  busy: (id) => preview().busy(id),
+                }}
+                onClose={() => setOpen(false)}
+              />
+            </div>
+          </Show>
+        </span>
+      )}
+    </Show>
+  )
+}
