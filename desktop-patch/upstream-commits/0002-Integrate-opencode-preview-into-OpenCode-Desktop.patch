diff --git a/packages/desktop/src/main/previews/service-host.ts b/packages/desktop/src/main/previews/service-host.ts
new file mode 100644
index 0000000..f6e4f8d
--- /dev/null
+++ b/packages/desktop/src/main/previews/service-host.ts
@@ -0,0 +1,88 @@
+import { ipcMain, type IpcMainInvokeEvent } from "electron"
+import { PreviewService } from "@orel56000/opencode-preview/service"
+import { PreviewIpcChannel } from "@orel56000/opencode-preview/ipc"
+import { openExternalURL } from "../windows"
+
+/**
+ * Preview backend host for Electron main.
+ *
+ * One `PreviewService` per project directory (shared across windows).
+ * The renderer never spawns processes — it calls these typed IPC handlers.
+ * Unknown port occupants are reported, never killed (enforced by the service).
+ */
+
+const services = new Map<string, PreviewService>()
+
+export function getPreviewService(projectDirectory: string): PreviewService {
+  const existing = services.get(projectDirectory)
+  if (existing) return existing
+  const service = new PreviewService({
+    projectDirectory,
+    opener: (url) => openExternalURL(url),
+  })
+  services.set(projectDirectory, service)
+  void service.init()
+  return service
+}
+
+function readDirectory(payload: unknown): string {
+  const directory = (payload as { directory?: unknown } | null)?.directory
+  if (typeof directory !== "string" || directory.length === 0 || directory.length > 4096) {
+    throw new Error("Invalid preview directory")
+  }
+  return directory
+}
+
+function readId(payload: unknown): string {
+  const id = (payload as { id?: unknown } | null)?.id
+  if (typeof id !== "string" || id.length === 0 || id.length > 128) {
+    throw new Error("Invalid preview id")
+  }
+  return id
+}
+
+function readLimit(payload: unknown): number | undefined {
+  const limit = (payload as { limit?: unknown } | null)?.limit
+  if (limit === undefined) return undefined
+  if (typeof limit !== "number" || !Number.isInteger(limit) || limit < 1 || limit > 2000) {
+    throw new Error("Invalid log limit")
+  }
+  return limit
+}
+
+export function registerPreviewIpcHandlers(): void {
+  ipcMain.handle(PreviewIpcChannel.list, (event: IpcMainInvokeEvent, payload: unknown) => {
+    void event
+    return getPreviewService(readDirectory(payload)).list()
+  })
+  ipcMain.handle(PreviewIpcChannel.start, (_event: IpcMainInvokeEvent, payload: unknown) => {
+    return getPreviewService(readDirectory(payload)).start(readId(payload))
+  })
+  ipcMain.handle(PreviewIpcChannel.stop, async (_event: IpcMainInvokeEvent, payload: unknown) => {
+    await getPreviewService(readDirectory(payload)).stop(readId(payload))
+  })
+  ipcMain.handle(PreviewIpcChannel.restart, (_event: IpcMainInvokeEvent, payload: unknown) => {
+    return getPreviewService(readDirectory(payload)).restart(readId(payload))
+  })
+  ipcMain.handle(PreviewIpcChannel.open, async (_event: IpcMainInvokeEvent, payload: unknown) => {
+    await getPreviewService(readDirectory(payload)).open(readId(payload))
+  })
+  ipcMain.handle(PreviewIpcChannel.logs, (_event: IpcMainInvokeEvent, payload: unknown) => {
+    return getPreviewService(readDirectory(payload)).logs(readId(payload), readLimit(payload))
+  })
+}
+
+export function removePreviewIpcHandlers(): void {
+  for (const channel of Object.values(PreviewIpcChannel)) {
+    ipcMain.removeHandler(channel)
+  }
+}
+
+/** Stops all managed preview processes. Called during app shutdown. */
+export async function disposePreviewServices(): Promise<void> {
+  const all = [...services.values()]
+  services.clear()
+  for (const service of all) {
+    await service.dispose()
+  }
+}
